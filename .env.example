# SIH26117 — copy to .env and override as needed (no secrets here)
# Paths (absolute or relative to project root)
#RAW_DIR=data/raw
#PROCESSED_DIR=data/processed
#VECTOR_STORE_DIR=data/vector_store
#DB_PATH=data/workbench.db

# Validation / chunking
#ALLOWED_EXTENSIONS=pdf,csv,json,txt,log,md
#MAX_FILE_SIZE_BYTES=52428800
#MAX_BATCH_SIZE_BYTES=524288000
#CHUNK_SIZE=800
#CHUNK_OVERLAP=120

# Embeddings (Phase 3)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_COLLECTION=chunks
RETRIEVAL_TOP_K=6
RETRIEVAL_THRESHOLD=0.0

# LLM (Phase 4) — local-only, mock default
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
LLM_HOST=http://localhost:11434
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
ALLOW_CLOUD_ADAPTER=false

# Vision (Phase 10)
VISION_PROVIDER=mock
VISION_MODEL=llava:7b
VISION_HOST=http://localhost:11434
VISION_TIMEOUT_S=30
VISION_MAX_IMAGE_BYTES=10485760
